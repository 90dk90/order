+++ handoff-diff/pd/pppoeclient.h	2026-08-05 20:57:56.840515424 +0000
@@ -509,6 +509,16 @@
   f64 auth_backoff_jitter_fraction;
   u32 rng_seed;
 
+  /* Soft handoff after PPPoE session unwrap (Digi Option B).
+   * When enabled and workers > 1, IP4/IP6 payloads leave the WAN RX worker
+   * via frame queues bound to ip4-input / ip6-input so post-PPPoE work
+   * (VXLAN, fib, NAT, output) spreads across workers. PPP control stays
+   * local on the RX worker. Default: on when workers > 1. */
+  u8 soft_handoff_enabled;
+  u32 fq_ip4_index;
+  u32 fq_ip6_index;
+  u32 soft_handoff_n_workers;
+
   /* convenience */
   vlib_main_t *vlib_main;
   vnet_main_t *vnet_main;
