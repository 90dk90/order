[Unit]
Description=Digi-only sticky max-BW egress (after PD GRE)
After=vpp.service vpp-pppoe-native.service
Wants=vpp.service vpp-pppoe-native.service
# pd-gre-activate (ExecStartPost of vpp-pppoe-native) also re-applies sticky
# when /etc/pd/sticky-digi exists; this unit covers cold boot ordering.
# Mid-run recovery: pd-gre-watchdog.timer restarts pppoe + activate if digi drops.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sleep 3
ExecStart=/usr/local/sbin/digi-sticky-outbound.sh

[Install]
WantedBy=multi-user.target
