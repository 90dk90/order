[Unit]
Description=Digi sticky outbound (TCP bulk via Digi SNAT; PD /24 inbound)
After=vpp.service vpp-pppoe-native.service
Wants=vpp.service vpp-pppoe-native.service
# Opt-in: enable with systemctl enable --now after setting PD_ENABLE_STICKY=1
# or run: PD_ENABLE_STICKY=1 /usr/local/sbin/digi-sticky-outbound.sh --force

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PD_ENABLE_STICKY=1
ExecStart=/usr/local/sbin/digi-sticky-outbound.sh --force
ExecStop=/usr/local/sbin/digi-sticky-disable.sh

[Install]
WantedBy=multi-user.target
